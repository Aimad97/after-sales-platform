APP_NAME=ServiceDesk
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=plateforme_sav
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
ATTACHMENTS_DISK=attachments
ATTACHMENTS_LEGACY_DISK=local
ATTACHMENTS_MAX_SIZE_KB=10240
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

DASHBOARD_CACHE_TTL_SECONDS=60
DASHBOARD_OVERDUE_TICKET_AFTER_DAYS=3

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

NOTIFICATIONS_MAIL_QUEUE=mail
NOTIFY_WARRANTY_EXPIRATION=false
WARRANTY_EXPIRATION_NOTICE_DAYS=30
WARRANTY_EXPIRATION_NOTICE_SCHEDULE=08:00

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
ATTACHMENTS_AWS_BUCKET=
ATTACHMENTS_AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_API_URL=http://localhost:8000/api
FRONTEND_URL=http://localhost:5173
VITE_REVERB_APP_KEY=servicedesk-local-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

CORS_ALLOWED_ORIGINS=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173

REVERB_APP_ID=servicedesk-local
REVERB_APP_KEY=servicedesk-local-key
REVERB_APP_SECRET=change-this-local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

INVOICE_DEFAULT_TAX_RATE=20
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

SUPER_ADMIN_EMAIL=superadmin@servicedesk.test
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin
