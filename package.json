{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "format": "prettier --write resources/js vite.config.js eslint.config.js prettier.config.js",
        "format:check": "prettier --check resources/js vite.config.js eslint.config.js prettier.config.js",
        "lint": "eslint resources/js vite.config.js eslint.config.js",
        "lint:fix": "npm run lint -- --fix",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:frontend": "npm run test",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.0.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.4",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^5.2.0",
        "concurrently": "^9.0.1",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.4",
        "globals": "^17.11.0",
        "jsdom": "^29.1.1",
        "laravel-vite-plugin": "^2.0.0",
        "prettier": "^3.9.6",
        "tailwindcss": "^4.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.67.0",
        "vite": "^7.0.7",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "@hookform/resolvers": "^5.7.1",
        "@tanstack/react-query": "^5.101.4",
        "apexcharts": "^6.7.0",
        "axios": "^1.19.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "laravel-echo": "^2.4.0",
        "lucide-react": "^1.29.0",
        "pusher-js": "^8.6.0",
        "react": "^19.2.8",
        "react-apexcharts": "^2.1.1",
        "react-dom": "^19.2.8",
        "react-hook-form": "^7.84.0",
        "react-router-dom": "^7.18.2",
        "tailwind-merge": "^3.6.0",
        "zod": "^3.25.76"
    }
}
