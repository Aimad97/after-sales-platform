{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "module": "ESNext", "moduleResolution": "Bundler", "noEmit": true, "jsx": "react-jsx",
    "skipLibCheck": true, "isolatedModules": true, "resolveJsonModule": true,
    "paths": { "@/*": ["./resources/js/*"] }
  },
  "include": ["resources/js/**/*.ts", "resources/js/**/*.tsx"]
}
